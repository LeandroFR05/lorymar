# Plantilla de variables de entorno públicas para el frontend (RF-38, RF-41).
# Copia este archivo como .env y reemplaza los valores por los de tu proyecto de Supabase.
# Nunca incluyas claves privadas ni service_role aquí ni en .env.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publica-anon
